# --- api/ (Phase 6-7) ---
# +psycopg (not bare postgresql://): SQLAlchemy needs the driver named
# explicitly to pick psycopg v3 over the (uninstalled) psycopg2 default.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/anzenna
# Points api/test_db.py at a Postgres DB with DB_SCHEMA.sql applied (`alembic
# upgrade head`) -- see api/README.md. Falls back to DATABASE_URL if unset;
# only needed to keep local dev/test data separate from each other.
ANZENNA_TEST_DATABASE_URL=
API_SECRET_KEY=
# Per-API-key requests/second cap enforced by api/main.py's in-memory limiter.
ANZENNA_RATE_LIMIT_PER_SECOND=10

# --- engine/llm_judge.py (Phase 4) ---
GEMINI_API_KEY=
LLM_JUDGE_MODEL=gemini-2.5-flash
LLM_JUDGE_TIMEOUT_SECONDS=10

# --- billing (Phase 8) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_SCALE=

# --- dashboard/ (Phase 9) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- infra (Phase 12) ---
SENTRY_DSN=
